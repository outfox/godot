+#ifdef __wasm_atomics__
+static std::atomic<pthread_t> deviceThread{};
+static thread_local bool deviceWorker = false;
+static thread_local bool polling = false;
+static em_proxying_queue* WorkerQueue() {
+  static auto* queue = em_proxying_queue_create();
+  return queue;
+}
+extern "C" bool emwgpuIsDeviceWorker() {
+  return deviceWorker && !polling;
+}
+extern "C" void emwgpuPollDeviceCalls() {
+  polling = true;
+  emscripten_proxy_execute_queue(WorkerQueue());
+  polling = false;
+}
+extern "C" pthread_t emwgpuGetDeviceThread() {
+  auto owner = deviceThread.load();
+  return owner ? owner : emscripten_main_runtime_thread_id();
+}
+extern "C" EMSCRIPTEN_KEEPALIVE void emwgpuSetDeviceThread() {
+  WorkerQueue();
+  deviceThread.store(pthread_self());
+  deviceWorker = true;
+}
+extern "C" void emwgpuOnDeviceThread(void (*run)(void*), void* data) {
+  auto owner = emwgpuGetDeviceThread();
+  if (pthread_equal(owner, pthread_self())) {
+    run(data);
+  } else {
+    auto* queue = deviceThread.load() ? WorkerQueue() : emscripten_proxy_get_system_queue();
+    if (!emscripten_proxy_sync(queue, owner, run, data)) std::abort();
+  }
+}
+extern "C" double emwgpuProxyToDevice(int id, int count, double* args) {
+  struct Call { int id, count; double* args; double result; } call{id, count, args, 0};
+  emwgpuOnDeviceThread([](void* data) {
+    auto& c = *static_cast<Call*>(data);
+    c.result = EM_ASM_DOUBLE({
+      return WebGPU.ownerCalls[$0](...HEAPF64.subarray($2 / 8, $2 / 8 + $1));
+    }, c.id, c.count, c.args);
+  }, &call);
+  return call.result;
+}
+#endif
